#!/usr/bin/env python3
"""Fetch checksum-pinned upstream packaging tools, without system installation."""
import hashlib
import json
from pathlib import Path
import urllib.request
root = Path(__file__).resolve().parents[1]
destination = root / 'build/appimage-tools'
destination.mkdir(parents=True, exist_ok=True)
for name, spec in json.loads((root/'packaging/appimage/tools.json').read_text()).items():
    path = destination/name
    if not path.exists():
        temporary = path.with_suffix('.download')
        try:
            with urllib.request.urlopen(spec['url'],timeout=60) as response, temporary.open('wb') as output:
                while data := response.read(1024*1024):
                    output.write(data)
            if hashlib.file_digest(temporary.open('rb'),'sha256').hexdigest() != spec['sha256']:
                raise RuntimeError(f'Checksum mismatch: {name}; do not use unverified tooling')
            temporary.replace(path)
        finally:
            temporary.unlink(missing_ok=True)
    with path.open('rb') as source:
        if hashlib.file_digest(source,'sha256').hexdigest() != spec['sha256']:
            raise RuntimeError(f'Checksum mismatch: {name}')
    path.chmod(0o755)
    print(f'Verified {name}')
